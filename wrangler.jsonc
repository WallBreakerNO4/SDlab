{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sd-style-lab",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "sd-style-lab"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://wpieviymunwjewgkmncd.supabase.co",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_GqZ_w3-_QzufKjA1V-nHcA_MwyKXyj3"
	},
	"r2_buckets": [
		{
			"binding": "SDSL_R2_PRIVATE",
			"bucket_name": "sdsl-private"
		},
		{
			"binding": "SDSL_R2_PUBLIC",
			"bucket_name": "sdsl-public"
		}
	]
}
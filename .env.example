# ComfyUI Grid Generator - Environment Configuration Example
# Copy this file to .env and customize values as needed
# Note: .env is gitignored by default

# ============================================================================
# ComfyUI generation runtime
# ============================================================================
# Fresh run 业务参数（prompts / workflow / seed / 采样 / 选择器等）已迁移到
# `--config` YAML 提供；可直接参考 `data/runs/example.yaml`。
# 本节仅保留 generation runtime 所需的 5 个 `COMFYUI_*` 环境变量。

# ComfyUI server base URL (default: http://127.0.0.1:8188)
# Adjust if running ComfyUI on a different host or port
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Output directory root (default: comfyui_api_outputs)
# Generated run directories will be created under this path
COMFYUI_OUT_DIR=comfyui_api_outputs

# HTTP request timeout in seconds (default: 30.0)
# Timeout for individual HTTP requests to ComfyUI
COMFYUI_REQUEST_TIMEOUT_S=30.0

# Job timeout in seconds (default: 600.0)
# Maximum time to wait for a single prompt generation
COMFYUI_JOB_TIMEOUT_S=600.0

# Local concurrency (default: 1)
# Controls how many prompts are kept in flight; higher values can reduce idle time caused by image downloads.
COMFYUI_CONCURRENCY=1

# Optional runtime-only CLI overrides (not read from env):
#   --config data/runs/example.yaml
#   --run-dir comfyui_api_outputs/my-run
#   --dry-run
#   --client-id my-custom-client-id

# ============================================================================
# CLI 辅助工具
# ============================================================================
# CSV 转换工具的默认输入文件路径（仅影响交互菜单中留空时的默认值）

# CLI menu defaults for CSV converters (optional)
# Used when selecting convert_x_csv / convert_y_csv and leaving "Extra argv" empty
# CONVERT_X_DEFAULT_CSV=data/prompts/X/common_prompts.csv
# CONVERT_Y_DEFAULT_CSV=data/prompts/Y/300_NAI_Styles_Table-test.csv

# ============================================================================
# R2 Upload & Supabase 上传配置
# ============================================================================
# 以下变量在运行 R2 上传脚本时必填（dry-run 模式不需要）
# 配置指南：scripts/r2_upload/r2_provisioning.md、scripts/r2_upload/supabase_workflow.md
# IMPORTANT: 真实凭证只写入 .env（已 gitignore），切勿提交 .env

# --- Supabase（服务端访问）---
# Required for backend scripts to sync metadata and manage database rows
# Create project at: https://app.supabase.com
# service_role key has full bypass of RLS (use ONLY in trusted backend scripts)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional: SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase uploader performance knobs
# Batch size for upsert payload rows (must be >= 1)
# SUPABASE_UPSERT_BATCH_SIZE=100
# Max request body size in bytes for each upsert chunk (must be >= 1024)
# SUPABASE_UPSERT_MAX_BYTES=4000000
# Parallel workers for image_variants batch writes (must be >= 1)
# SUPABASE_DB_CONCURRENCY=2
# HTTP timeout (seconds) for PostgREST requests
# SUPABASE_HTTP_TIMEOUT_S=30
# Retries for transient PostgREST transport/server errors (0 = no retry)
# SUPABASE_HTTP_RETRIES=2

# --- Cloudflare R2 存储 ---
# R2 public storage: Public base URL for direct object access (e.g., r2.dev or custom domain)
# If using r2.dev: https://<R2_PUBLIC_BUCKET>.<ACCOUNT_ID>.r2.cloudflarestorage.com
# If using custom domain: https://images.your-custom-domain.com
R2_PUBLIC_BASE_URL=https://sdslab-public.your-account-id.r2.cloudflarestorage.com

# R2 private storage (S3 API endpoint)
# Cloudflare R2 S3 API endpoint. Get ACCOUNT_ID from Cloudflare R2 dashboard.
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Cloudflare R2 API Token credentials (S3 compatibility)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions: R2:Edit, Object Storage:Read & Write
R2_ACCESS_KEY_ID=your-access-key-id-here
R2_SECRET_ACCESS_KEY=your-secret-access-key-here

# Cloudflare R2 bucket names (Create using wrangler r2 bucket create)
R2_PUBLIC_BUCKET=sdslab-public
R2_PRIVATE_BUCKET=sdslab-private

# Optional: directory for processed image intermediate artifacts before upload
# If unset, uploader defaults to <run-root>/_r2_upload_intermediate
# R2_UPLOAD_INTERMEDIATE_DIR=comfyui_api_outputs/intermediate

# Worker count for R2 upload stage (default: 1)
# Controls concurrent image object uploads to better utilize network bandwidth. Must be >= 1.
# R2_UPLOAD_CONCURRENCY=8

# ============================================================================
# 图片编码参数（planned / not wired yet）
# ============================================================================
# 控制图像变体生成的质量与并发参数
# NOTE: 以下参数为规划中的默认值，尚未接入代码；实现后将从这些环境变量读取

# WebP quality levels (1-100, higher = better quality, larger file)
# R2_WEBP_LARGE_QUALITY=93  # L1: full-size display variant
# R2_WEBP_THUMB_QUALITY=82  # L2: 1/2 size thumbnail variant

# AVIF CRF approximation (not direct Pillow parameter, mapped internally)
# Lower = better quality, larger file; mapping documented in code
# R2_AVIF_LARGE_CRF=20      # L1: full-size display variant
# R2_AVIF_THUMB_CRF=28      # L2: 1/2 size thumbnail variant

# Blurhash component count (width x height, affects hash precision vs length)
# Recommended values: 3x3, 4x3, 4x4 (higher = more components, longer hash)
# R2_BLURHASH_COMPONENTS=4x3

# Worker count for image planning/encoding thread pool (default: CLI --concurrency)
# Set based on CPU cores; e.g. 4, 8, 16. Must be >= 1.
# R2_IMAGE_WORKERS=4

# ============================================================================
# Supabase Auth 配置（网站登录）
# ============================================================================
# 网站前端使用的公开 Supabase URL 与可发布密钥（可安全暴露在浏览器端）
# 与上方 SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 不同，这组 Key 供客户端 JS 使用
# NEXT_PUBLIC_ 前缀使其可在客户端 JavaScript 中访问
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY 与 SUPABASE_PUBLISHABLE_KEY 值相同
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- GitHub OAuth (configured in Supabase Dashboard > Auth > Providers) ---
# These are set in Supabase Dashboard, not needed in .env unless using local Supabase.
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-client-id
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-client-secret

# --- Google OAuth (configured in Supabase Dashboard > Auth > Providers) ---
# These are set in Supabase Dashboard, not needed in .env unless using local Supabase.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# --- Microsoft (Azure) OAuth (placeholder - not yet configured) ---
# SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=your-azure-client-id
# SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=your-azure-client-secret